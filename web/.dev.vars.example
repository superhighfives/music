# Copy to .dev.vars and fill in the Clerk development instance's keys:
# dashboard.clerk.com, application "music", API keys.
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
# API keys → JWT public key → PEM, in quotes; it runs over several lines.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

---
import '~/production/styles/app.css'
import Masthead from '~/components/Masthead.astro'
import PadMark from '~/components/PadMark.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import Page from '~/layouts/Page.astro'
import Controls from './islands/Controls'

// Production, the course: every page has the key, mode and tempo in its masthead.
interface Props {
  title: string
}
---

<Page title={Astro.props.title} description="A step-by-step course in music production with Ableton Live 12: sound quality, soundscapes, melody, songwriting, drums and mixing.">
  <div class="page" data-section="production">
    <Masthead>
      <a slot="brand" class="brand" href="/production"><PadMark lit={12} />Production</a>
      <Controls client:load />
    </Masthead>
    <slot />
    <SiteFooter current="production" />
  </div>
</Page>

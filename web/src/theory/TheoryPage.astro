---
import '~/theory/styles/theory.css'
import Masthead from '~/components/Masthead.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import Page from '~/layouts/Page.astro'
import { BOOK_TITLE } from '~/theory/content/book'
import { MastProgress } from './islands/Progress'

// The theory book. Noto Music draws its clefs, accidentals and rests.
interface Props {
  title: string
  description: string
}
---

<Page title={Astro.props.title} description={Astro.props.description}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Music&display=swap" />
  <div class="page" data-section="theory">
    <Masthead>
      <a slot="brand" class="brand" href="/theory">{BOOK_TITLE}</a>
      <MastProgress client:load />
    </Masthead>
    <slot />
    <SiteFooter current="theory" />
  </div>
</Page>

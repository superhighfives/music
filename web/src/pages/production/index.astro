---
import PadMark from '~/components/PadMark.astro'
import KeyBox from '~/production/islands/KeyBox'
import { Continue, RecipeList, ThemeCards } from '~/production/islands/CourseHome'
import ProductionPage from '~/production/ProductionPage.astro'

/** Edition log, newest first. Add a line when a theme or recipe lands. */
const LOG: [string, string, string][] = [
  ["2026-11-28", "Edition 8.", "A new theme, MIDI & audio: what MIDI messages are made of, channels and MIDI 2.0, digital audio, file formats and latency. Recording is planned, and Melody & harmony moves to Theory."],
  ["2026-11-27", "Edition 7.", "Every tool in the studio, with exercises and links back to these lessons, at music.charliegleason.com/tools."],
  ["2026-11-26", "Edition 6.", "sounds is now Production, at music.charliegleason.com/production."],
  ["2026-11-26", "Edition 5.", "Fog & Pulse is now just sounds, with the same footer as the rest of music."],
  ["2026-11-25", "Edition 4.", "Moves to music.charliegleason.com/sounds, beside chords and the Ableton Extensions."],
  ["2026-11-25", "Edition 3.", "Moves to sounds.charliegleason.com, built from the music repo and deployed on every push to main."],
  ["2026-11-25", "Edition 2.", "A course: six themes and recipes. The Sound quality theme, the “The Peace” vocoder recipe, and the in-this-key panel."],
  ["2026-11-24", "Edition 1.", "Fog & Pulse handbook: map, drums, textures, low end, space, arrangement, live rig."],
]
const date = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
---

<ProductionPage title="Production">
  <section class="hero">
    <PadMark lit={12} big />
    <h1>Production</h1>
    <p class="lede">
      A step-by-step course in music production with Ableton Live 12: high-quality audio, soundscapes, melody and pop songwriting. Big themes you work
      through in order, and short recipes that rebuild one sound from a real record.
    </p>
  </section>
  <div class="home">
    <Continue client:load />
    <section class="block">
      <h2>Themes <span class="dim">Longer courses, in order. Each lesson ends with something to make.</span></h2>
      <ThemeCards client:load />
    </section>
    <section class="block">
      <h2>Recipes <span class="dim">One sound, rebuilt from a real record.</span></h2>
      <RecipeList client:load />
    </section>
    <section class="block">
      <h2>
        In this key <span class="dim">Follows the key and mode above. Harmony in depth lives in <a href="/chords">Chords</a>.</span>
      </h2>
      <KeyBox client:load />
    </section>
    <section class="block">
      <h2>Tools <span class="dim">The plugins and gear these lessons use, with exercises for each.</span></h2>
      <p><a href="/tools">See every tool →</a></p>
    </section>
    <section class="block">
      <h2>Edition log</h2>
      <div class="log">
        {
          LOG.map(([d, title, text]) => (
            <div>
              <time datetime={d}>{date(d)}</time>
              <span>
                <b>{title}</b> {text}
              </span>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</ProductionPage>

{
  // Chords runs on Effect UI, which needs exactOptionalPropertyTypes. The rest of the app doesn't use it yet,
  // so the island is checked on its own. The route loads it through src/chords/app/mount.ts.
  "extends": "./tsconfig.json",
  "include": ["src/chords/app", "src/islands", "src/cloudflare.d.ts"],
  "exclude": [],
  "compilerOptions": {
    "exactOptionalPropertyTypes": true
  }
}
